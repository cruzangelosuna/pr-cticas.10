#include <iostream>
using namespace std;

int main() {
    int numero, limite;

    cout << "Que numero deseas multiplicar? ";
    cin >> numero;

    cout << "Hasta que numero? ";
    cin >> limite;

    if (limite < 1) {
        cout << "Limite no valido.\n";
    } else {
        int i = 1;

        while (i <= limite) {
            cout << numero << " x " << i
                 << " = " << numero * i << endl;
            i++;
        }
    }

    return 0;
}
