#include <iostream>
using namespace std;

int main() {
    double calificacion1;
    double calificacion2;
    double calificacion3;

    cout << "Ingresa tres calificaciones: ";

    cin >> calificacion1
        >> calificacion2
        >> calificacion3;

    if (!cin) {
        cout << "Error: ingresa valores numericos.\n";
        return 1;
    }

    double promedio =
        (calificacion1 + calificacion2 + calificacion3) / 3.0;

    cout << "El promedio es: "
         << promedio << endl;

    return 0;
}
