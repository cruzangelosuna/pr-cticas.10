#include <iostream>
#include <cmath>
using namespace std;

void ecuacionLineal(double a, double b) {
    if (a == 0) {
        if (b == 0)
            cout << "Infinitas soluciones.\n";
        else
            cout << "No tiene solucion.\n";
    } else {
        cout << "Solucion: x = " << -b / a << endl;
    }
}

void ecuacionCuadratica(double a, double b, double c) {
    if (a == 0) {
        cout << "Se resolvera como ecuacion lineal.\n";
        ecuacionLineal(b, c);
        return;
    }

    double discriminante = b * b - 4 * a * c;

    if (discriminante > 0) {
        cout << "Dos soluciones reales:\n";
        cout << "x1 = "
             << (-b + sqrt(discriminante)) / (2 * a) << endl;

        cout << "x2 = "
             << (-b - sqrt(discriminante)) / (2 * a) << endl;

    } else if (discriminante == 0) {
        cout << "Una solucion: "
             << -b / (2 * a) << endl;
    } else {
        cout << "No tiene soluciones reales.\n";
    }
}

int main() {
    int opcion;
    double a, b, c;

    cout << "1. Ecuacion lineal\n";
    cout << "2. Ecuacion cuadratica\n";
    cout << "Elige una opcion: ";
    cin >> opcion;

    if (opcion == 1) {
        cout << "Ingresa a y b: ";
        cin >> a >> b;

        ecuacionLineal(a, b);

    } else if (opcion == 2) {
        cout << "Ingresa a, b y c: ";
        cin >> a >> b >> c;

        ecuacionCuadratica(a, b, c);

    } else {
        cout << "Opcion no valida.\n";
    }

    return 0;
}
